# --- Database Configuration ---
# OPTION 1: Vercel Postgres (Recommended if hosting on Vercel)
# These will be automatically injected into your Vercel deployment.
# For local development, copy them from your Vercel dashboard:
POSTGRES_URL=postgres://default:<pwd>@ep-...-pooler.region.postgres.vercel-storage.com/verceldb?pgbouncer=true&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgres://default:<pwd>@ep-...region.postgres.vercel-storage.com/verceldb

# OPTION 2: Supabase Postgres
# Runtime: transaction pooler (port 6543). prepare:false is mandatory.
DATABASE_URL=postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations only: direct connection (port 5432).
DIRECT_URL=postgresql://postgres:<pwd>@db.<ref>.supabase.co:5432/postgres

# --- better-auth ---
BETTER_AUTH_SECRET=<random 32+ chars>
BETTER_AUTH_URL=http://localhost:3000

# --- AI assistant (Google Gemini) ---
GEMINI_API_KEY=

# --- External league data (football-data.org) ---
FOOTBALL_DATA_KEY=

# --- Optional: Supabase Storage/Realtime from the client only ---
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
